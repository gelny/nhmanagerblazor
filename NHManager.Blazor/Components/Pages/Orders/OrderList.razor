@page "/orders"
@attribute [Authorize(Roles = Roles.AllEmployees)]
@using Microsoft.Extensions.Localization
@using NHManager.Blazor.Resources
@inject IOrderService OrderService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using NHManager.Blazor.Models
@using NHManager.Blazor.Services
@using NHManager.Blazor.Constants
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Orders"] - NHManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@Loc["Orders"]</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="8">
                <!-- Search implemented client-side on full list -->
                <MudTextField @bind-Value="_searchString" Placeholder="@Loc["SearchOrders"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true"></MudTextField>
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
                 <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/orders/create">@Loc["NewOrder"]</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable Items="@_orders" Filter="new Func<Order,bool>(FilterFunc)" Dense="true" Hover="true" @ref="_table">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>@Loc["CreationDate"]</MudTh>
            <MudTh>@Loc["Client"]</MudTh>
            <MudTh>@Loc["Consultant"]</MudTh>
            <MudTh>@Loc["Items"]</MudTh>
            <MudTh Style="width: 120px;">@Loc["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="@Loc["CreationDate"]">@context.CreateDate.ToString("dd.MM.yyyy HH:mm")</MudTd>
            <MudTd DataLabel="@Loc["Client"]">
                @if (context.Client != null)
                {
                   <MudLink Href="@($"/clients/{context.ClientId}")">@context.ClientFullName</MudLink>
                }
            </MudTd>
            <MudTd DataLabel="@Loc["Consultant"]">@context.ConsultantFullName</MudTd>
            <MudTd DataLabel="@Loc["Items"]">
                <MudTooltip Text="@context.OrderItemsString">
                    <MudText Typo="Typo.body2">@context.OrderItems.Count @Loc["Items"].Value.ToLower()</MudText>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="@Loc["Actions"]">
                <MudTooltip Text="@Loc["Edit"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" Href="@($"/orders/edit/{context.Id}")" />
                </MudTooltip>
                <MudTooltip Text="@Loc["Delete"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteOrder(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@string.Format(Loc["NotFound"].Value, Loc["Orders"].Value)</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<Order> _orders = new();
    private MudTable<Order> _table = new();
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        _orders = await OrderService.GetAllAsync();
    }

    private bool FilterFunc(Order order) => FilterFunc(order, _searchString);

    private bool FilterFunc(Order order, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        
        if (order.ClientFullName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (order.ConsultantFullName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (order.Id.ToString().Contains(searchString))
            return true;
        
        return false;
    }

    private async Task DeleteOrder(Order order)
    {
        bool? result = await DialogService.ShowMessageBox(
            string.Format(Loc["DeleteTitle"].Value, Loc["Order"].Value), 
            string.Format(Loc["DeleteConfirmation"].Value, Loc["Order"].Value, order.Id), 
            yesText: Loc["Delete"], cancelText: Loc["Cancel"]);
        
        if (result == true)
        {
             try
             {
                 var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                 var userName = authState.User.Identity?.Name ?? "System";
                 
                 await OrderService.DeleteAsync(order.Id, userName);
                 Snackbar.Add(string.Format(Loc["DeletedSuccess"].Value, Loc["Order"].Value), Severity.Success);
                 _orders = await OrderService.GetAllAsync();
             }
             catch (Exception ex)
             {
                 Snackbar.Add(string.Format(Loc["ErrorDeleting"].Value, ex.Message), Severity.Error);
             }
        }
    }
}
