@inject IStringLocalizer<SharedResource> Loc

@if (_hasData)
{
    <ApexChart TItem="ChartDataPoint" Options="_options" Height="400">
        <ApexPointSeries TItem="ChartDataPoint"
                         Items="_data"
                         Name="@Loc["BMR_KCAL"]"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("dd.MM.yyyy"))"
                         YValue="@(e => (decimal)e.Value)" />
    </ApexChart>
}
else
{
    <MudAlert Severity="Severity.Info">@Loc["Graph_NoData"]</MudAlert>
}

@code {
    [Parameter] public Client? Client { get; set; }

    private List<ChartDataPoint> _data = new();
    private bool _hasData;
    private ApexChartOptions<ChartDataPoint> _options = new();

    protected override void OnParametersSet()
    {
        _data.Clear();

        if (Client?.Measurements == null)
        {
            _hasData = false;
            return;
        }

        var measurements = Client.Measurements
            .Where(m => m.Results != null && m.Results.Any(r => r.BRM_KCAL > 0))
            .OrderBy(m => m.Date)
            .ToList();

        foreach (var m in measurements)
        {
            var result = m.Results!.First(r => r.BRM_KCAL > 0);
            _data.Add(new ChartDataPoint(m.Date, result.BRM_KCAL));
        }

        _data = ChartDataPoint.DeduplicateByDate(_data);

        _hasData = _data.Count > 0;

        _options = new ApexChartOptions<ChartDataPoint>
        {
            Chart = new Chart { Type = ApexCharts.ChartType.Line },
            Xaxis = new XAxis { Type = XAxisType.Category },
            Stroke = new Stroke { Curve = Curve.Smooth }
        };
    }
}
