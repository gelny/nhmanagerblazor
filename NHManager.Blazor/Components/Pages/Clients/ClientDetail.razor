    private async Task DownloadDocument(int documentId, string? fileNameWithPath)
    {
        try
        {
            var fileBytes = await DocumentService.DownloadFileAsync(documentId);
            if (fileBytes != null)
            {
                var originalFileName = Path.GetFileName(fileNameWithPath);
                // Remove GUID prefix if present (format: GUID_filename.ext)
                if (!string.IsNullOrEmpty(originalFileName) && originalFileName.Contains('_'))
                {
                    originalFileName = originalFileName.Substring(originalFileName.IndexOf('_') + 1);
                }
                
                using var stream = new MemoryStream(fileBytes);
                using var streamRef = new DotNetStreamReference(stream);
                await JS.InvokeVoidAsync("downloadFileFromStream", originalFileName, streamRef);
            }
            else
            {
                 Snackbar.Add(Loc["FileNotFound"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Loc["Error"]}: {ex.Message}", Severity.Error);
