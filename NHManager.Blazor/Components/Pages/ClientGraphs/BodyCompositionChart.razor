@inject IStringLocalizer<SharedResource> Loc

@if (_hasData)
{
    <ApexChart TItem="ChartDataPoint" Options="_options" Height="400">
        <ApexPointSeries TItem="ChartDataPoint"
                         Items="_fatData"
                         Name="@Loc["FatPercentage"]"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("dd.MM.yyyy"))"
                         YValue="@(e => (decimal)e.Value)" />
        <ApexPointSeries TItem="ChartDataPoint"
                         Items="_waterData"
                         Name="@Loc["WaterPercentage"]"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("dd.MM.yyyy"))"
                         YValue="@(e => (decimal)e.Value)" />
        <ApexPointSeries TItem="ChartDataPoint"
                         Items="_leanData"
                         Name="@Loc["LeanBodyMass"]"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("dd.MM.yyyy"))"
                         YValue="@(e => (decimal)e.Value)" />
    </ApexChart>
}
else
{
    <MudAlert Severity="Severity.Info">@Loc["Graph_NoData"]</MudAlert>
}

@code {
    [Parameter] public Client? Client { get; set; }

    private List<ChartDataPoint> _fatData = new();
    private List<ChartDataPoint> _waterData = new();
    private List<ChartDataPoint> _leanData = new();
    private bool _hasData;
    private ApexChartOptions<ChartDataPoint> _options = new();

    protected override void OnParametersSet()
    {
        _fatData.Clear();
        _waterData.Clear();
        _leanData.Clear();

        if (Client?.Measurements == null)
        {
            _hasData = false;
            return;
        }

        var measurements = Client.Measurements
            .Where(m => m.FatPercentage > 0 || m.WaterPercentage > 0 || m.LeanBodyMass > 0)
            .OrderBy(m => m.Date)
            .ToList();

        foreach (var m in measurements)
        {
            if (m.FatPercentage > 0)
                _fatData.Add(new ChartDataPoint(m.Date, m.FatPercentage));
            if (m.WaterPercentage > 0)
                _waterData.Add(new ChartDataPoint(m.Date, m.WaterPercentage));
            if (m.LeanBodyMass > 0)
                _leanData.Add(new ChartDataPoint(m.Date, m.LeanBodyMass));
        }

        _fatData = ChartDataPoint.DeduplicateByDate(_fatData);
        _waterData = ChartDataPoint.DeduplicateByDate(_waterData);
        _leanData = ChartDataPoint.DeduplicateByDate(_leanData);

        _hasData = _fatData.Count > 0 || _waterData.Count > 0 || _leanData.Count > 0;

        _options = new ApexChartOptions<ChartDataPoint>
        {
            Chart = new Chart { Type = ApexCharts.ChartType.Line },
            Xaxis = new XAxis { Type = XAxisType.Category },
            Stroke = new Stroke { Curve = Curve.Smooth }
        };
    }
}
