@using NHManager.Blazor.Constants
@using NHManager.Blazor.Services
@using Microsoft.Extensions.Localization
@using NHManager.Blazor.Resources
@inject IStringLocalizer<SharedResource> Loc
@inject IDemoDataService DemoDataService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="nav-menu-container">
    <MudNavMenu Bordered="true" Color="Color.Primary" Class="pt-2">
        <AuthorizeView Roles="@Roles.AllEmployees">
            <Authorized>
                <MudText Typo="Typo.overline" Class="nav-section-header">@Loc["Dashboard"]</MudText>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.Dashboard">@Loc["Dashboard"]</MudNavLink>
                <MudNavLink Href="/scheduler" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.CalendarMonth">@Loc["Scheduler"]</MudNavLink>
                <MudNavLink Href="/meetings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.EventNote">@Loc["Meetings"]</MudNavLink>

                <MudDivider Class="my-2 mx-3" />
                <MudText Typo="Typo.overline" Class="nav-section-header">@Loc["Clients"]</MudText>
                <MudNavLink Href="/clients" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.PeopleAlt">@Loc["Clients"]</MudNavLink>
                <MudNavLink Href="/orders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.ShoppingBag">@Loc["Orders"]</MudNavLink>
                <MudNavLink Href="/recipes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.MenuBook">@Loc["Recipes"]</MudNavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.SuperEmployee">
            <Authorized>
                <MudDivider Class="my-2 mx-3" />
                <MudText Typo="Typo.overline" Class="nav-section-header">@Loc["Settings"]</MudText>
                <MudNavLink Href="/products" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Inventory2">@Loc["Products"]</MudNavLink>
                <MudNavLink Href="/foods" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Restaurant">@Loc["Foods"]</MudNavLink>
                <MudNavLink Href="/workers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Badge">@Loc["Workers"]</MudNavLink>
                <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.ManageAccounts">@Loc["Users"]</MudNavLink>
                <MudDivider Class="my-2 mx-3" />
                <MudNavLink OnClick="GenerateDemoData"
                            Icon="@(_generating ? Icons.Material.Rounded.HourglassTop : Icons.Material.Rounded.AutoFixHigh)"
                            Disabled="@_generating">
                    @(_generating ? Loc["DemoDataGenerating"] : Loc["DemoDataGenerate"])
                </MudNavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.AdminAndSuper">
            <Authorized>
                <MudDivider Class="my-2 mx-3" />
                <MudNavGroup Title="@Loc["Settings"]" Icon="@Icons.Material.Rounded.Tune" Expanded="false">
                    <MudNavLink Href="/settings/meeting-types" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Category">@Loc["MeetingTypes"]</MudNavLink>
                    <MudNavLink Href="/settings/meeting-states" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Flag">@Loc["MeetingStates"]</MudNavLink>
                    <MudNavLink Href="/settings/activity-types" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.FitnessCenter">@Loc["ActivityTypes"]</MudNavLink>
                </MudNavGroup>
            </Authorized>
        </AuthorizeView>
    </MudNavMenu>
</div>

@code {
    private bool _generating;

    private async Task GenerateDemoData()
    {
        var result = await DialogService.ShowMessageBox(
            Loc["DemoDataGenerate"],
            Loc["DemoDataConfirm"],
            yesText: Loc["Yes"],
            cancelText: Loc["Cancel"]);

        if (result != true)
            return;

        _generating = true;
        StateHasChanged();

        try
        {
            await DemoDataService.GenerateAsync();
            Snackbar.Add(Loc["DemoDataSuccess"], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Loc["DemoDataError"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _generating = false;
            StateHasChanged();
        }
    }
}
