                    <MudText Typo="Typo.h6" Class="mb-4">@Loc["PersonalGoals_Description"]</MudText>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudCheckBox @bind-Value="_completed1" Label="@Loc["SectionCompleted"]" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudCheckBox T="bool" Label="@Loc["Goal_LoseWeight"]" Value="@(_questionnaire.Q_1_1 == 1)" ValueChanged="@(v => _questionnaire.Q_1_1 = v ? 1 : 0)" />
                            <MudCheckBox T="bool" Label="@Loc["Goal_GainWeight"]" Value="@(_questionnaire.Q_1_2 == 1)" ValueChanged="@(v => _questionnaire.Q_1_2 = v ? 1 : 0)" />
                            <MudCheckBox T="bool" Label="@Loc["Goal_MaintainWeight"]" Value="@(_questionnaire.Q_1_3 == 1)" ValueChanged="@(v => _questionnaire.Q_1_3 = v ? 1 : 0)" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                             <MudNumericField T="int" Label="@($"{Loc["WeightChangeAmount"]} (kg)")" @bind-Value="_questionnaire.Q_1_4" Variant="Variant.Outlined" Min="0" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Label="@Loc["Goal_Motivation"]" @bind-Value="_questionnaire.Q_1_13" Variant="Variant.Outlined" Lines="3" />
                            <MudTextField Label="@Loc["Goal_Obstacles"]" @bind-Value="_questionnaire.Q_1_14" Variant="Variant.Outlined" Lines="3" Class="mt-4" />
                            <MudTextField Label="@Loc["Goal_FirstStep"]" @bind-Value="_questionnaire.Q_1_15" Variant="Variant.Outlined" Lines="3" Class="mt-4" />
                        </MudItem>
                    </MudGrid>
