@inherits LayoutComponentBase
@using Microsoft.Extensions.Localization
@using NHManager.Blazor.Resources
@inject IStringLocalizer<SharedResource> Loc

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="appbar-gradient">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <div class="d-flex align-center ml-2 gap-2">
            <MudIcon Icon="@Icons.Material.Rounded.Spa" Size="Size.Large" />
            <MudText Typo="Typo.h6" Style="font-weight: 600; letter-spacing: 0.5px;">NHManager</MudText>
        </div>
        <MudSpacer />

        <LanguageSelector />

        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
                               Color="Color.Inherit"
                               OnClick="@ToggleDarkMode"
                               Class="mr-2" />
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudChip T="string" Color="Color.Default" Class="user-chip">
                            <AvatarContent>
                                <MudAvatar Color="Color.Secondary" Size="Size.Small">
                                    @(context.User.Identity?.Name?.Substring(0, 1).ToUpper())
                                </MudAvatar>
                            </AvatarContent>
                            <ChildContent>
                                <MudText Typo="Typo.body2">@context.User.Identity?.Name</MudText>
                            </ChildContent>
                        </MudChip>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Rounded.Logout" Href="/logout">@Loc["Logout"]</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Color="Color.Inherit" Variant="Variant.Text" Href="/login" StartIcon="@Icons.Material.Rounded.Login">@Loc["Login"]</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Mini" OpenMiniOnHover="true"
               Class="drawer-custom">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="main-content-bg">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6 px-4 px-md-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

