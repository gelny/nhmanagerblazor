@code {
    [Parameter]
    public int ClientId { get; set; }
    
    [Parameter]
    public int Id { get; set; }
    


    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private ClientQuestionnaire? _questionnaire;
    private Client? _client;
    private DateTime? _questionnaireDate;
    private bool _loading = true;
    private bool _saving = false;
    private int _activeTabIndex = 0;

    private IEnumerable<Food> _selectedFoods_Q5_8_Objects = new HashSet<Food>();
    private IEnumerable<Food> _selectedFoods_Q5_9_Objects = new HashSet<Food>();
    private IEnumerable<Food> _selectedFoods_Q5_18_Objects = new HashSet<Food>();
    
    private bool SearchFoodsExtended(Food food, string value)
    {
        if (string.IsNullOrEmpty(value))
            return true;

        return food.Name?.Contains(value, StringComparison.InvariantCultureIgnoreCase) ?? false;
    }
    


    private List<Food> _foods = new();
    private HashSet<int> _selectedFoods_Q5_8 = new();
    private HashSet<int> _selectedFoods_Q5_9 = new();
    private HashSet<int> _selectedFoods_Q5_18 = new();

    protected override async Task OnInitializedAsync()
    {
        _client = await ClientService.GetByIdAsync(ClientId);
        _foods = await FoodService.GetAllAsync();
        _questionnaire = await QuestionnaireService.GetByIdAsync(Id);
        
        if (_questionnaire != null)
        {
            _questionnaireDate = _questionnaire.Date;
            
            // Map booleans based on bindings removed

            
            // Map IDs from model to selected values
            _questionnaire.MapFoodIds();
            _selectedFoods_Q5_8_Objects = _foods.Where(f => (_questionnaire.Q_5_8_FoodIds ?? new List<int>()).Contains(f.Id)).ToHashSet();
            _selectedFoods_Q5_9_Objects = _foods.Where(f => (_questionnaire.Q_5_9_FoodIds ?? new List<int>()).Contains(f.Id)).ToHashSet();
            _selectedFoods_Q5_18_Objects = _foods.Where(f => (_questionnaire.Q_5_18_FoodIds ?? new List<int>()).Contains(f.Id)).ToHashSet();
        }
        
        // Set active tab based on query parameter
        if (!string.IsNullOrEmpty(Tab))
        {
            _activeTabIndex = Tab.ToLower() switch
            {
                "goals" => 0,
                "diagnosis" => 1,
                "risks" => 2,
                "family" => 3,
                "preferences" => 4,
                "lifestyle" => 5,
                "lymphatic" => 6,
                _ => 0
            };
        }

        _loading = false;
    }

    private async Task HandleSubmit()
    {
        if (_questionnaire == null) return;
        
        _saving = true;
        try
        {



            _questionnaire.Date = _questionnaireDate ?? DateTime.Today;
            
            // Auto-complete the currently active section
            switch (_activeTabIndex)
            {
                case 0: _questionnaire.Completed_1 = true; break;
                case 1: _questionnaire.Completed_2 = true; break;
                case 2: _questionnaire.Completed_3 = true; break;
                case 3: _questionnaire.Completed_4 = true; break;
                case 4: _questionnaire.Completed_5 = true; break;
                case 5: _questionnaire.Completed_6 = true; break;
                case 6: _questionnaire.Completed_7 = true; break;
            }

             // Map food selections
            // Map food selections
            _questionnaire.Q_5_8_FoodIds = _selectedFoods_Q5_8_Objects.Select(f => f.Id).ToList();
            _questionnaire.Q_5_9_FoodIds = _selectedFoods_Q5_9_Objects.Select(f => f.Id).ToList();
            _questionnaire.Q_5_18_FoodIds = _selectedFoods_Q5_18_Objects.Select(f => f.Id).ToList();
            _questionnaire.MapFoodStrings();

            await QuestionnaireService.UpdateAsync(_questionnaire);
            Snackbar.Add(Loc["SaveSuccess"], Severity.Success);
            Navigation.NavigateTo($"/clients/{ClientId}?tab=questionnaires");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Loc["Error"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo($"/clients/{ClientId}?tab=questionnaires");
    }
}
