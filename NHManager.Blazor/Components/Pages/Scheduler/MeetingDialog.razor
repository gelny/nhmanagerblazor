@using NHManager.Blazor.Models
@using NHManager.Blazor.Services
@using NHManager.Blazor.Resources
@using Microsoft.Extensions.Localization
@inject IClientService ClientService
@inject IStringLocalizer<SharedResource> Loc

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? Loc["NewMeeting"] : Loc["EditMeeting"])</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="Meeting.Title" Label="@Loc["Name"]" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudAutocomplete T="Client" Label="@Loc["Client"]" @bind-Value="_selectedClient"
                                 SearchFunc="@SearchClients"
                                 ToStringFunc="@(c => c == null ? null : $"{c.SurName} {c.FirstName}")"
                                 Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="Meeting.ConsultantId" Label="@Loc["Consultant"]" Variant="Variant.Outlined" T="int?">
                    <MudSelectItem Value="@((int?)null)">@Loc["NoneSelected"]</MudSelectItem>
                    @foreach (var worker in Workers)
                    {
                        <MudSelectItem Value="@((int?)worker.Id)">@worker.FullName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudDatePicker Label="@($"{Loc["Name"]} (Od)")" @bind-Date="_fromDate" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTimePicker Label="Od" @bind-Time="_fromTime" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudDatePicker Label="@($"{Loc["Name"]} (Do)")" @bind-Date="_toDate" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTimePicker Label="Do" @bind-Time="_toTime" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="Meeting.MeetingTypeId" Label="@Loc["MeetingType"]" Variant="Variant.Outlined" T="int" Required="true">
                    @foreach (var type in MeetingTypes)
                    {
                        <MudSelectItem Value="@type.Id">@type.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="Meeting.MeetingStateId" Label="@Loc["MeetingState"]" Variant="Variant.Outlined" T="int" Required="true">
                    @foreach (var state in MeetingStates)
                    {
                        <MudSelectItem Value="@state.Id">@state.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="Meeting.Description" Label="@Loc["Description"]" Variant="Variant.Outlined" Lines="3" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        @if (!IsNew)
        {
            <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="OnDelete" Class="mr-auto">@Loc["Delete"]</MudButton>
        }
        <MudButton OnClick="Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@Loc["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Meeting Meeting { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public List<Worker> Workers { get; set; } = new();
    [Parameter] public List<MeetingType> MeetingTypes { get; set; } = new();
    [Parameter] public List<MeetingState> MeetingStates { get; set; } = new();

    private Client? _selectedClient;
    private DateTime? _fromDate;
    private TimeSpan? _fromTime;
    private DateTime? _toDate;
    private TimeSpan? _toTime;

    protected override void OnParametersSet()
    {
        _fromDate = Meeting.From.Date;
        _fromTime = Meeting.From.TimeOfDay;
        _toDate = Meeting.To.Date;
        _toTime = Meeting.To.TimeOfDay;

        if (Meeting.Client != null)
        {
            _selectedClient = Meeting.Client;
        }
    }

    private async Task<IEnumerable<Client>> SearchClients(string value, CancellationToken token)
    {
        return await ClientService.GetAllAsync(value);
    }

    private void Submit()
    {
        if (_fromDate.HasValue && _fromTime.HasValue)
            Meeting.From = _fromDate.Value.Date + _fromTime.Value;

        if (_toDate.HasValue && _toTime.HasValue)
            Meeting.To = _toDate.Value.Date + _toTime.Value;

        if (_selectedClient != null)
            Meeting.ClientId = _selectedClient.Id;
        else
            Meeting.ClientId = null;

        MudDialog.Close(DialogResult.Ok(Meeting));
    }

    private void Cancel() => MudDialog.Cancel();

    private void OnDelete()
    {
        MudDialog.Close(DialogResult.Ok("delete"));
    }
}
