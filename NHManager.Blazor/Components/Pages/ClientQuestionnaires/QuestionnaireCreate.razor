                            <MudCheckBox T="bool" Label="@Loc["Diagnosis_Prediabetes"]" Value="@(_questionnaire.Q_2_2 == 1)" ValueChanged="@(v => _questionnaire.Q_2_2 = v ? 1 : 0)" />
