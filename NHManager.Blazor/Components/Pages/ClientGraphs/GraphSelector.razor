                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Bloodtype" Color="MudBlazor.Color.Secondary" />
                    <MudText Typo="Typo.subtitle1">@Loc["Graph_LipidProfileAnalysis"]</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Class="cursor-pointer" @onclick="@(() => OnGraphSelected.InvokeAsync("glucoseanalysis"))">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.WaterDrop" Color="MudBlazor.Color.Secondary" />
                    <MudText Typo="Typo.subtitle1">@Loc["Graph_GlucoseAnalysis"]</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Class="cursor-pointer" @onclick="@(() => OnGraphSelected.InvokeAsync("whr"))">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.CompareArrows" Color="MudBlazor.Color.Secondary" />
                    <MudText Typo="Typo.subtitle1">@Loc["Graph_WHR"]</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Class="cursor-pointer" @onclick="@(() => OnGraphSelected.InvokeAsync("atherogenic"))">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Analytics" Color="MudBlazor.Color.Secondary" />
                    <MudText Typo="Typo.subtitle1">@Loc["Graph_AtherogenicIndex"]</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

