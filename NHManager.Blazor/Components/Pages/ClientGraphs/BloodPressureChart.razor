@inject IStringLocalizer<SharedResource> Loc

@if (_hasData)
{
    <ApexChart TItem="ChartDataPoint" Options="_options" Height="400">
        <ApexPointSeries TItem="ChartDataPoint"
                         Items="_systolicData"
                         Name="@Loc["SystolicBloodPressure"]"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("dd.MM.yyyy"))"
                         YValue="@(e => (decimal)e.Value)" />
        <ApexPointSeries TItem="ChartDataPoint"
                         Items="_diastolicData"
                         Name="@Loc["DiastolicBloodPressure"]"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("dd.MM.yyyy"))"
                         YValue="@(e => (decimal)e.Value)" />
    </ApexChart>
}
else
{
    <MudAlert Severity="Severity.Info">@Loc["Graph_NoData"]</MudAlert>
}

@code {
    [Parameter] public Client? Client { get; set; }

    private List<ChartDataPoint> _systolicData = new();
    private List<ChartDataPoint> _diastolicData = new();
    private bool _hasData;
    private ApexChartOptions<ChartDataPoint> _options = new();

    protected override void OnParametersSet()
    {
        _systolicData.Clear();
        _diastolicData.Clear();

        if (Client?.Measurements == null)
        {
            _hasData = false;
            return;
        }

        var measurements = Client.Measurements
            .Where(m => m.SystolicBloodPressure > 0 || m.DiastolicBloodPressure > 0)
            .OrderBy(m => m.Date)
            .ToList();

        foreach (var m in measurements)
        {
            if (m.SystolicBloodPressure > 0)
                _systolicData.Add(new ChartDataPoint(m.Date, m.SystolicBloodPressure));
            if (m.DiastolicBloodPressure > 0)
                _diastolicData.Add(new ChartDataPoint(m.Date, m.DiastolicBloodPressure));
        }

        _systolicData = ChartDataPoint.DeduplicateByDate(_systolicData);
        _diastolicData = ChartDataPoint.DeduplicateByDate(_diastolicData);

        _hasData = _systolicData.Count > 0 || _diastolicData.Count > 0;

        _options = new ApexChartOptions<ChartDataPoint>
        {
            Chart = new Chart { Type = ApexCharts.ChartType.Line },
            Xaxis = new XAxis { Type = XAxisType.Category },
            Stroke = new Stroke { Curve = Curve.Smooth }
        };
    }
}
