@inject IStringLocalizer<SharedResource> Loc

@if (_hasData && _hasRecData)
{
    <ApexChart TItem="ChartDataPoint" Options="_optionsWithRec" Height="400">
        <ApexPointSeries TItem="ChartDataPoint"
                         Items="_data"
                         Name="@Loc["Weight"]"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("dd.MM.yyyy"))"
                         YValue="@(e => (decimal)e.Value)" />
        <ApexPointSeries TItem="ChartDataPoint"
                         Items="_recMinData"
                         Name="Min"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("dd.MM.yyyy"))"
                         YValue="@(e => (decimal)e.Value)" />
        <ApexPointSeries TItem="ChartDataPoint"
                         Items="_recMaxData"
                         Name="Max"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("dd.MM.yyyy"))"
                         YValue="@(e => (decimal)e.Value)" />
    </ApexChart>
}
else if (_hasData)
{
    <ApexChart TItem="ChartDataPoint" Options="_options" Height="400">
        <ApexPointSeries TItem="ChartDataPoint"
                         Items="_data"
                         Name="@Loc["Weight"]"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("dd.MM.yyyy"))"
                         YValue="@(e => (decimal)e.Value)" />
    </ApexChart>
}
else
{
    <MudAlert Severity="Severity.Info">@Loc["Graph_NoData"]</MudAlert>
}

@code {
    [Parameter] public Client? Client { get; set; }

    private List<ChartDataPoint> _data = new();
    private List<ChartDataPoint> _recMinData = new();
    private List<ChartDataPoint> _recMaxData = new();
    private bool _hasData;
    private bool _hasRecData;
    private ApexChartOptions<ChartDataPoint> _options = new();
    private ApexChartOptions<ChartDataPoint> _optionsWithRec = new();

    protected override void OnParametersSet()
    {
        _data.Clear();
        _recMinData.Clear();
        _recMaxData.Clear();

        if (Client?.Measurements == null)
        {
            _hasData = false;
            _hasRecData = false;
            return;
        }

        var measurements = Client.Measurements
            .Where(m => m.Weight > 0)
            .OrderBy(m => m.Date)
            .ToList();

        foreach (var m in measurements)
        {
            _data.Add(new ChartDataPoint(m.Date, m.Weight));
            var result = m.Results?.FirstOrDefault();
            if (result != null)
            {
                if (result.Weight_RecommendedMin > 0)
                    _recMinData.Add(new ChartDataPoint(m.Date, result.Weight_RecommendedMin));
                if (result.Weight_RecommendedMax > 0)
                    _recMaxData.Add(new ChartDataPoint(m.Date, result.Weight_RecommendedMax));
            }
        }

        _hasData = _data.Count > 0;
        _hasRecData = _recMinData.Count > 0 || _recMaxData.Count > 0;

        _options = new ApexChartOptions<ChartDataPoint>
        {
            Chart = new Chart { Type = ApexCharts.ChartType.Line },
            Xaxis = new XAxis { Type = XAxisType.Category },
            Stroke = new Stroke { Curve = Curve.Smooth }
        };

        _optionsWithRec = new ApexChartOptions<ChartDataPoint>
        {
            Chart = new Chart { Type = ApexCharts.ChartType.Line },
            Xaxis = new XAxis { Type = XAxisType.Category },
            Stroke = new Stroke
            {
                Curve = Curve.Smooth,
                DashArray = new List<double> { 0, 6, 6 }
            }
        };
    }
}
