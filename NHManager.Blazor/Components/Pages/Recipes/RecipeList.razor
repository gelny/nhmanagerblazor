@page "/recipes"
@attribute [Authorize(Roles = Roles.AllEmployees)]
@using Microsoft.Extensions.Localization
@using NHManager.Blazor.Resources
@inject IRecipeService RecipeService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using NHManager.Blazor.Models
@using NHManager.Blazor.Services
@using NHManager.Blazor.Constants
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Recipes"] - NHManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@Loc["Recipes"]</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="8">
                <MudTextField T="string" ValueChanged="OnSearch" Placeholder="@Loc["SearchRecipes"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true"></MudTextField>
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
                 <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/recipes/create">@Loc["NewRecipe"]</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable ServerData="@(new Func<TableState, CancellationToken, Task<TableData<Recipe>>>(ServerData))" Dense="true" Hover="true" @ref="_table">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="Name" T="Recipe">@Loc["Name"]</MudTableSortLabel></MudTh>
             <MudTh>@Loc["Items"]</MudTh>
            <MudTh><MudTableSortLabel SortLabel="EnergyKcal" T="Recipe">@string.Format("{0} ({1})", Loc["Energy"].Value, Loc["Kcal"].Value)</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="Protein" T="Recipe">@Loc["Protein"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="Carbohydrate" T="Recipe">@Loc["Carbohydrate"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="Fat" T="Recipe">@Loc["Fat"]</MudTableSortLabel></MudTh>
            <MudTh Style="width: 120px;">@Loc["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Loc["Name"]">@context.Name</MudTd>
            <MudTd DataLabel="@Loc["Items"]">@context.RecipeItems.Count</MudTd>
            <MudTd DataLabel="@string.Format("{0} ({1})", Loc["Energy"].Value, Loc["Kcal"].Value)">@context.EnergyKcal</MudTd>
            <MudTd DataLabel="@Loc["Protein"]">@context.Protein</MudTd>
            <MudTd DataLabel="@Loc["Carbohydrate"]">@context.Carbohydrate</MudTd>
            <MudTd DataLabel="@Loc["Fat"]">@context.Fat</MudTd>
            <MudTd DataLabel="@Loc["Actions"]">
                <MudTooltip Text="@Loc["Edit"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" Href="@($"/recipes/edit/{context.Id}")" />
                </MudTooltip>
                <MudTooltip Text="@Loc["Delete"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteRecipe(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
         <NoRecordsContent>
            <MudText>@string.Format(Loc["NotFound"].Value, Loc["Recipes"].Value)</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private MudTable<Recipe> _table = new();
    private string _searchString = "";

    private async Task<TableData<Recipe>> ServerData(TableState state, CancellationToken token)
    {
        var result = await RecipeService.GetRecipesAsync(
            state.Page, 
            state.PageSize, 
            _searchString, 
            state.SortLabel, 
            state.SortDirection == SortDirection.Ascending ? 1 : 2
        );

        return new TableData<Recipe> { TotalItems = result.TotalCount, Items = result.Items };
    }

    private void OnSearch(string text)
    {
        _searchString = text;
        _table.ReloadServerData();
    }

    private async Task DeleteRecipe(Recipe recipe)
    {
        bool? result = await DialogService.ShowMessageBox(
            string.Format(Loc["DeleteTitle"].Value, Loc["Recipe"].Value), 
            string.Format(Loc["DeleteConfirmation"].Value, Loc["Recipe"].Value, recipe.Name), 
            yesText: Loc["Delete"], cancelText: Loc["Cancel"]);
        
        if (result == true)
        {
             try
             {
                 var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                 var userName = authState.User.Identity?.Name ?? "System";
                 
                 await RecipeService.DeleteAsync(recipe.Id, userName);
                 Snackbar.Add(string.Format(Loc["DeletedSuccess"].Value, Loc["Recipe"].Value), Severity.Success);
                 await _table.ReloadServerData();
             }
             catch (Exception ex)
             {
                 Snackbar.Add(string.Format(Loc["ErrorDeleting"].Value, ex.Message), Severity.Error);
             }
        }
    }
}
