@inject IStringLocalizer<SharedResource> Loc

<MudText Typo="Typo.h6" Class="mb-3">@Loc["Measurements"]</MudText>
<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Class="cursor-pointer" @onclick="@(() => OnGraphSelected.InvokeAsync("weight"))">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.MonitorWeight" Color="MudBlazor.Color.Primary" />
                    <MudText Typo="Typo.subtitle1">@Loc["Weight"]</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Class="cursor-pointer" @onclick="@(() => OnGraphSelected.InvokeAsync("bmi"))">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Speed" Color="MudBlazor.Color.Primary" />
                    <MudText Typo="Typo.subtitle1">BMI</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Class="cursor-pointer" @onclick="@(() => OnGraphSelected.InvokeAsync("fat"))">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Percent" Color="MudBlazor.Color.Primary" />
                    <MudText Typo="Typo.subtitle1">@Loc["FatPercentage"]</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Class="cursor-pointer" @onclick="@(() => OnGraphSelected.InvokeAsync("bodycomposition"))">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Accessibility" Color="MudBlazor.Color.Primary" />
                    <MudText Typo="Typo.subtitle1">@Loc["Graph_BodyComposition"]</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Class="cursor-pointer" @onclick="@(() => OnGraphSelected.InvokeAsync("circumferences"))">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Straighten" Color="MudBlazor.Color.Primary" />
                    <MudText Typo="Typo.subtitle1">@Loc["BodyCircumferences"]</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Class="cursor-pointer" @onclick="@(() => OnGraphSelected.InvokeAsync("bloodpressure"))">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="MudBlazor.Color.Primary" />
                    <MudText Typo="Typo.subtitle1">@Loc["Graph_BloodPressure"]</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Class="cursor-pointer" @onclick="@(() => OnGraphSelected.InvokeAsync("visceralfat"))">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Color="MudBlazor.Color.Primary" />
                    <MudText Typo="Typo.subtitle1">@Loc["VisceralFat"]</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Class="cursor-pointer" @onclick="@(() => OnGraphSelected.InvokeAsync("metabolicage"))">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Elderly" Color="MudBlazor.Color.Primary" />
                    <MudText Typo="Typo.subtitle1">@Loc["MetabolicAge"]</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Class="cursor-pointer" @onclick="@(() => OnGraphSelected.InvokeAsync("bmr"))">
            <MudCardContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Color="MudBlazor.Color.Primary" />
                    <MudText Typo="Typo.subtitle1">@Loc["BMR_KCAL"]</MudText>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

