@using Microsoft.Extensions.Localization
@using NHManager.Blazor.Resources
@inject IStringLocalizer<SharedResource> Loc

@if (_timelineItems == null || !_timelineItems.Any())
{
    <MudAlert Severity="Severity.Info">@Loc["NoRecordsFound"]</MudAlert>
}
else
{
    <MudTimeline TimelinePosition="TimelinePosition.Alternate">
        @foreach (var item in _timelineItems)
        {
            <MudTimelineItem Color="@GetColor(item.Color)" Size="Size.Medium" Elevation="1">
                <ItemOpposite>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Date.ToString("dd.MM.yyyy")</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@item.Category</MudChip>
                </ItemOpposite>
                <ItemDot>
                    <MudIcon Icon="@item.Icon" Size="Size.Small" />
                </ItemDot>
                <ItemContent>
                    <MudPaper Elevation="0" Class="pa-3" Style="border: 1px solid var(--mud-palette-divider);">
                        <MudText Typo="Typo.body1" Style="font-weight: 600;">@item.Title</MudText>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Description</MudText>
                        }
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>
        }
    </MudTimeline>
}

@code {
    [Parameter]
    public Client? Client { get; set; }

    private List<TimelineItem>? _timelineItems;

    protected override void OnParametersSet()
    {
        if (Client != null)
            BuildTimeline();
    }

    private void BuildTimeline()
    {
        var items = new List<TimelineItem>();

        // Meetings
        if (Client!.Meetings != null)
        {
            foreach (var m in Client.Meetings)
            {
                items.Add(new TimelineItem
                {
                    Date = m.From,
                    Title = m.Title ?? m.MeetingType?.Name ?? "Schůzka",
                    Description = $"{m.From:HH:mm} - {m.To:HH:mm}" + (m.MeetingState != null ? $" ({m.MeetingState.Name})" : ""),
                    Category = Loc["Meeting"],
                    Icon = Icons.Material.Rounded.Event,
                    Color = m.MeetingType?.Color ?? "#2E7D6F"
                });
            }
        }

        // Measurements
        if (Client.Measurements != null)
        {
            foreach (var m in Client.Measurements)
            {
                items.Add(new TimelineItem
                {
                    Date = m.Date,
                    Title = Loc["Measurement"],
                    Description = $"{Loc["Weight"]}: {m.Weight:F1} kg, {Loc["FatPercentage"]}: {m.FatPercentage:F1}%",
                    Category = Loc["Measurement"],
                    Icon = Icons.Material.Rounded.MonitorWeight,
                    Color = "#5CA4C9"
                });
            }
        }

        // Events
        if (Client.Events != null)
        {
            foreach (var e in Client.Events)
            {
                items.Add(new TimelineItem
                {
                    Date = e.Date,
                    Title = Loc["Events"],
                    Description = e.Description,
                    Category = Loc["Events"],
                    Icon = Icons.Material.Rounded.EventNote,
                    Color = "#F4A261"
                });
            }
        }

        // Documents
        if (Client.Documents != null)
        {
            foreach (var d in Client.Documents)
            {
                items.Add(new TimelineItem
                {
                    Date = d.CreatedAt,
                    Title = d.Name,
                    Category = Loc["Documents"],
                    Icon = Icons.Material.Rounded.Description,
                    Color = "#264653"
                });
            }
        }

        // Analysis
        if (Client.Analysis != null)
        {
            foreach (var a in Client.Analysis)
            {
                items.Add(new TimelineItem
                {
                    Date = a.Date,
                    Title = Loc["Analysis"],
                    Description = $"{Loc["Glucose"]}: {a.Glucose:F1}, {Loc["TotalCholesterol"]}: {a.TotalCholesterol:F1}",
                    Category = Loc["Analysis"],
                    Icon = Icons.Material.Rounded.Analytics,
                    Color = "#4CAF50"
                });
            }
        }

        // Biochemistry
        if (Client.Biochemistry != null)
        {
            foreach (var b in Client.Biochemistry)
            {
                items.Add(new TimelineItem
                {
                    Date = b.Date,
                    Title = Loc["Biochemistry"],
                    Description = $"{Loc["Glucose"]}: {b.Glucose:F1}",
                    Category = Loc["Biochemistry"],
                    Icon = Icons.Material.Rounded.Science,
                    Color = "#9C27B0"
                });
            }
        }

        // Orders
        if (Client.Orders != null)
        {
            foreach (var o in Client.Orders)
            {
                items.Add(new TimelineItem
                {
                    Date = o.CreateDate,
                    Title = Loc["Order"],
                    Description = $"{o.OrderItems?.Count ?? 0} {Loc["Items"]}",
                    Category = Loc["Order"],
                    Icon = Icons.Material.Rounded.ShoppingBag,
                    Color = "#E76F51"
                });
            }
        }

        _timelineItems = items.OrderByDescending(i => i.Date).ToList();
    }

    private MudBlazor.Color GetColor(string hex)
    {
        return hex.ToLower() switch
        {
            "#2e7d6f" => MudBlazor.Color.Primary,
            "#5ca4c9" => MudBlazor.Color.Info,
            "#f4a261" => MudBlazor.Color.Warning,
            "#e76f51" => MudBlazor.Color.Error,
            "#4caf50" => MudBlazor.Color.Success,
            "#264653" => MudBlazor.Color.Dark,
            "#9c27b0" => MudBlazor.Color.Secondary,
            _ => MudBlazor.Color.Primary
        };
    }
}
