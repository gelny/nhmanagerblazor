@code {
    [Parameter]
    public int ClientId { get; set; }
    
    private ClientQuestionnaire _questionnaire = new();
    private Client? _client;
    private DateTime? _questionnaireDate = DateTime.Today;
    private bool _saving = false;
    
    // Checkbox bindings for Completed_X properties
    private bool _completed1;
    private bool _completed2;
    private bool _completed3;
    private bool _completed4;
    private bool _completed5;
    private bool _completed6;
    private bool _completed7;

    private List<Food> _foods = new();
    private IEnumerable<int> _selectedFoods_Q5_8 = new HashSet<int>();
    private IEnumerable<int> _selectedFoods_Q5_9 = new HashSet<int>();
    private IEnumerable<int> _selectedFoods_Q5_18 = new HashSet<int>();

    protected override async Task OnInitializedAsync()
    {
        _client = await ClientService.GetByIdAsync(ClientId);
        _foods = await FoodService.GetAllAsync();
        _questionnaire.ClientId = ClientId;
        _questionnaire.Date = DateTime.Today;
    }

    private async Task HandleSubmit()
    {
        _saving = true;
        try
        {
            _questionnaire.Date = _questionnaireDate ?? DateTime.Today;
            
            // Map booleans to model
            _questionnaire.Completed_1 = _completed1;
            _questionnaire.Completed_2 = _completed2;
            _questionnaire.Completed_3 = _completed3;
            _questionnaire.Completed_4 = _completed4;
            _questionnaire.Completed_5 = _completed5;
            _questionnaire.Completed_6 = _completed6;
            _questionnaire.Completed_6 = _completed6;
            _questionnaire.Completed_7 = _completed7;

            // Map food selections
            _questionnaire.Q_5_8_FoodIds = _selectedFoods_Q5_8.ToList();
            _questionnaire.Q_5_9_FoodIds = _selectedFoods_Q5_9.ToList();
            _questionnaire.Q_5_18_FoodIds = _selectedFoods_Q5_18.ToList();
            _questionnaire.MapFoodStrings();

            await QuestionnaireService.CreateAsync(_questionnaire);
            Snackbar.Add(Loc["SaveSuccess"], Severity.Success);
            Navigation.NavigateTo($"/clients/{ClientId}?tab=questionnaires");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Loc["Error"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo($"/clients/{ClientId}?tab=questionnaires");
    }
}
