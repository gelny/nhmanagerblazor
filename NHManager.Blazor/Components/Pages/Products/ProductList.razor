@page "/products"
@attribute [Authorize(Roles = Roles.AllEmployees)]
@using Microsoft.Extensions.Localization
@using NHManager.Blazor.Resources
@inject IProductService ProductService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using NHManager.Blazor.Models
@using NHManager.Blazor.Services
@using NHManager.Blazor.Constants
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Products"] - NHManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@Loc["Products"]</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="8">
                <!-- Search implemented client-side on full list -->
                <MudTextField @bind-Value="_searchString" Placeholder="@Loc["SearchProducts"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true"></MudTextField>
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
                 <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/products/create">@Loc["NewProduct"]</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable Items="@_products" Filter="new Func<Product,bool>(FilterFunc)" Dense="true" Hover="true" @ref="_table">
        <HeaderContent>
            <MudTh>@Loc["Name"]</MudTh>
            <MudTh>@Loc["PriceNoVAT"]</MudTh>
            <MudTh>@Loc["VAT"]</MudTh>
            <MudTh>@Loc["PriceWithVAT"]</MudTh>
            <MudTh>@Loc["Active"]</MudTh>
            <MudTh Style="width: 120px;">@Loc["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Loc["Name"]">@context.Name</MudTd>
            <MudTd DataLabel="@Loc["PriceNoVAT"]">@context.Price.ToString("C2")</MudTd>
            <MudTd DataLabel="@Loc["VAT"]">@context.VAT</MudTd>
            <MudTd DataLabel="@Loc["PriceWithVAT"]">@context.PriceWithVAT.ToString("C2")</MudTd>
            <MudTd DataLabel="@Loc["Active"]">
                @if (context.Active)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@Loc["Yes"]</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">@Loc["No"]</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="@Loc["Actions"]">
                <MudTooltip Text="@Loc["Edit"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" Href="@($"/products/edit/{context.Id}")" />
                </MudTooltip>
                <MudTooltip Text="@Loc["Delete"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteProduct(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@string.Format(Loc["NotFound"].Value, Loc["Products"].Value)</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<Product> _products = new();
    private MudTable<Product> _table = new();
    private string _searchString = "";

    protected override async Task OnInitializedAsync()
    {
        _products = await ProductService.GetAllAsync(activeOnly: false);
    }

    private bool FilterFunc(Product product) => FilterFunc(product, _searchString);

    private bool FilterFunc(Product product, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        
        if (product.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        
        return false;
    }

    private async Task DeleteProduct(Product product)
    {
        bool? result = await DialogService.ShowMessageBox(
            string.Format(Loc["DeleteTitle"].Value, Loc["Product"].Value), 
            string.Format(Loc["DeleteConfirmation"].Value, Loc["Product"].Value, product.Name), 
            yesText: Loc["Delete"], cancelText: Loc["Cancel"]);
        
        if (result == true)
        {
             try
             {
                 var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                 var userName = authState.User.Identity?.Name ?? "System";
                 
                 await ProductService.DeleteAsync(product.Id, userName);
                 Snackbar.Add(string.Format(Loc["DeletedSuccess"].Value, Loc["Product"].Value), Severity.Success);
                 _products = await ProductService.GetAllAsync(activeOnly: false);
             }
             catch (Exception ex)
             {
                 Snackbar.Add(string.Format(Loc["ErrorDeleting"].Value, ex.Message), Severity.Error);
             }
        }
    }
}
