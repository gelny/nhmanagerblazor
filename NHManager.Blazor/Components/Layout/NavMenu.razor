@using NHManager.Blazor.Constants
@using NHManager.Blazor.Services
@using Microsoft.Extensions.Localization
@using NHManager.Blazor.Resources
@inject IStringLocalizer<SharedResource> Loc
@inject IDemoDataService DemoDataService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudNavMenu>
    <AuthorizeView Roles="@Roles.AllEmployees">
        <Authorized>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">@Loc["Dashboard"]</MudNavLink>
            <MudNavLink Href="/scheduler" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CalendarMonth">@Loc["Scheduler"]</MudNavLink>
            <MudNavLink Href="/meetings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Event">@Loc["Meetings"]</MudNavLink>
            <MudNavLink Href="/clients" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">@Loc["Clients"]</MudNavLink>
            <MudNavLink Href="/orders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ShoppingCart">@Loc["Orders"]</MudNavLink>
            <MudNavLink Href="/recipes" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MenuBook">@Loc["Recipes"]</MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@Roles.SuperEmployee">
        <Authorized>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/products" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory">@Loc["Products"]</MudNavLink>
            <MudNavLink Href="/foods" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Restaurant">@Loc["Foods"]</MudNavLink>
            <MudNavLink Href="/workers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Badge">@Loc["Workers"]</MudNavLink>
            <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">@Loc["Users"]</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink OnClick="GenerateDemoData"
                        Icon="@(_generating ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.AutoFixHigh)"
                        Disabled="@_generating">
                @(_generating ? Loc["DemoDataGenerating"] : Loc["DemoDataGenerate"])
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@Roles.AdminAndSuper">
        <Authorized>
            <MudDivider Class="my-2" />
            <MudNavGroup Title="@Loc["Settings"]" Icon="@Icons.Material.Filled.Settings">
                <MudNavLink Href="/settings/meeting-types" Match="NavLinkMatch.Prefix">@Loc["MeetingTypes"]</MudNavLink>
                <MudNavLink Href="/settings/meeting-states" Match="NavLinkMatch.Prefix">@Loc["MeetingStates"]</MudNavLink>
                <MudNavLink Href="/settings/activity-types" Match="NavLinkMatch.Prefix">@Loc["ActivityTypes"]</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private bool _generating;

    private async Task GenerateDemoData()
    {
        var result = await DialogService.ShowMessageBox(
            Loc["DemoDataGenerate"],
            Loc["DemoDataConfirm"],
            yesText: Loc["Yes"],
            cancelText: Loc["Cancel"]);

        if (result != true)
            return;

        _generating = true;
        StateHasChanged();

        try
        {
            await DemoDataService.GenerateAsync();
            Snackbar.Add(Loc["DemoDataSuccess"], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Loc["DemoDataError"]}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _generating = false;
            StateHasChanged();
        }
    }
}
