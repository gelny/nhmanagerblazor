@page "/scheduler"
@attribute [Authorize(Roles = Roles.AllEmployees)]
@inject IMeetingService MeetingService
@inject IMeetingTypeService MeetingTypeService
@inject IMeetingStateService MeetingStateService
@inject IWorkerService WorkerService
@inject IClientService ClientService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@using NHManager.Blazor.Models
@using NHManager.Blazor.Services
@using NHManager.Blazor.Constants
@using Microsoft.Extensions.Localization
@using NHManager.Blazor.Resources
@using System.Globalization
@inject IStringLocalizer<SharedResource> Loc
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>@Loc["Scheduler"] - NHManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    @* Employee filter row *@
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.subtitle2" Class="mr-2">@Loc["Workers"]:</MudText>
            @foreach (var worker in _workerFilters)
            {
                var w = worker;
                <MudCheckBox T="bool" Value="@w.Selected" ValueChanged="@(v => OnWorkerFilterChanged(w, v))"
                             Label="@w.Name" Color="Color.Primary" Dense="true" />
            }
        </MudStack>
    </MudPaper>

    @* Toolbar row *@
    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudStack Row="true" Spacing="1">
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                    <MudButton OnClick="@(() => ChangeView("timeGridDay"))"
                               Variant="@(_currentView == "timeGridDay" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary">@Loc["Day"]</MudButton>
                    <MudButton OnClick="@(() => ChangeView("timeGridWeek"))"
                               Variant="@(_currentView == "timeGridWeek" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary">@Loc["Week"]</MudButton>
                    <MudButton OnClick="@(() => ChangeView("dayGridMonth"))"
                               Variant="@(_currentView == "dayGridMonth" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary">@Loc["Month"]</MudButton>
                </MudButtonGroup>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="Prev" Size="Size.Small" />
                <MudButton Variant="Variant.Text" OnClick="GoToToday" Size="Size.Small">@Loc["Today"]</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="Next" Size="Size.Small" />
                <MudDatePicker Date="_selectedDate" DateChanged="OnDatePickerChanged" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Style="max-width: 180px;" />
            </MudStack>
        </MudStack>
    </MudPaper>

    @* Calendar container *@
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    <div id="fullcalendar-container"></div>
</MudContainer>

@code {
    private List<Worker> _workers = new();
    private List<WorkerSchedulerFilter> _workerFilters = new();
    private List<MeetingType> _meetingTypes = new();
    private List<MeetingState> _meetingStates = new();
    private List<Meeting> _meetings = new();
    private bool _loading = true;
    private bool _calendarInitialized = false;
    private string _currentView = "timeGridWeek";
    private DateTime? _selectedDate = DateTime.Today;
    private DotNetObjectReference<Scheduler>? _dotNetRef;
    private string _userName = "System";
    private bool _suppressDatePickerCallback = false;

    // Date range currently displayed by the calendar
    private DateTime _viewStart;
    private DateTime _viewEnd;

    // Employee color palette
    private static readonly string[] WorkerColors = {
        "#1976D2", "#D32F2F", "#388E3C", "#7B1FA2", "#F57C00",
        "#0097A7", "#C2185B", "#512DA8", "#00796B", "#AFB42B",
        "#5D4037", "#455A64", "#E64A19", "#1565C0", "#2E7D32"
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userName = authState.User.Identity?.Name ?? "System";

        _workers = await WorkerService.GetActiveAsync();
        _meetingTypes = await MeetingTypeService.GetAllAsync();
        _meetingStates = await MeetingStateService.GetAllAsync();

        _workerFilters = _workers.Select((w, i) => new WorkerSchedulerFilter(i, w.FullName, w.Id) { Selected = true }).ToList();
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            var locale = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
            if (locale != "cs" && locale != "pl") locale = "cs";

            await JS.InvokeVoidAsync("schedulerInterop.initialize", "fullcalendar-container", _dotNetRef, new
            {
                initialView = _currentView,
                locale = locale
            });
            _calendarInitialized = true;
        }
    }

    [JSInvokable]
    public async Task OnDatesSet(string startStr, string endStr, string viewType)
    {
        _viewStart = DateTime.Parse(startStr, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind);
        _viewEnd = DateTime.Parse(endStr, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind);
        _currentView = viewType;

        // Update selected date from calendar without triggering DatePicker callback
        var dateStr = await JS.InvokeAsync<string>("schedulerInterop.getDate");
        _suppressDatePickerCallback = true;
        _selectedDate = DateTime.Parse(dateStr, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind).Date;

        await RefreshEvents();
        StateHasChanged();
        _suppressDatePickerCallback = false;
    }

    [JSInvokable]
    public async Task OnDateClick(string dateStr, bool allDay)
    {
        DateTime clickedDate;
        if (DateTime.TryParse(dateStr, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var parsed))
            clickedDate = parsed;
        else
            clickedDate = DateTime.Now;

        // For month view all-day clicks, default to 9:00
        if (allDay || _currentView == "dayGridMonth")
        {
            clickedDate = clickedDate.Date.AddHours(9);
        }

        var meeting = new Meeting
        {
            From = clickedDate,
            To = clickedDate.AddHours(1),
            MeetingTypeId = _meetingTypes.FirstOrDefault()?.Id ?? 0,
            MeetingStateId = _meetingStates.FirstOrDefault()?.Id ?? 0
        };

        var parameters = new DialogParameters<MeetingDialog>
        {
            { x => x.Meeting, meeting },
            { x => x.IsNew, true },
            { x => x.Workers, _workers },
            { x => x.MeetingTypes, _meetingTypes },
            { x => x.MeetingStates, _meetingStates }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<MeetingDialog>(Loc["NewMeeting"], parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is Meeting newMeeting)
        {
            try
            {
                await MeetingService.CreateAsync(newMeeting, _userName);
                Snackbar.Add(string.Format(Loc["CreatedSuccess"], Loc["Meeting"]), Severity.Success);
                await RefreshEvents();
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(Loc["ErrorCreating"], ex.Message), Severity.Error);
            }
        }
    }

    [JSInvokable]
    public async Task OnEventClick(int id)
    {
        var meeting = await MeetingService.GetByIdAsync(id);
        if (meeting == null) return;

        var parameters = new DialogParameters<MeetingDialog>
        {
            { x => x.Meeting, meeting },
            { x => x.IsNew, false },
            { x => x.Workers, _workers },
            { x => x.MeetingTypes, _meetingTypes },
            { x => x.MeetingStates, _meetingStates }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<MeetingDialog>(Loc["EditMeeting"], parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            if (result.Data is string action && action == "delete")
            {
                var confirm = await DialogService.ShowMessageBox(
                    string.Format(Loc["DeleteTitle"], Loc["Meeting"]),
                    string.Format(Loc["DeleteConfirmation"], Loc["Meeting"], meeting.Title ?? ""),
                    yesText: Loc["Yes"], cancelText: Loc["No"]);

                if (confirm == true)
                {
                    try
                    {
                        await MeetingService.DeleteAsync(id, _userName);
                        Snackbar.Add(string.Format(Loc["DeletedSuccess"], Loc["Meeting"]), Severity.Success);
                        await RefreshEvents();
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add(string.Format(Loc["ErrorDeleting"], ex.Message), Severity.Error);
                    }
                }
            }
            else if (result.Data is Meeting updatedMeeting)
            {
                try
                {
                    await MeetingService.UpdateAsync(updatedMeeting, _userName);
                    Snackbar.Add(string.Format(Loc["UpdatedSuccess"], Loc["Meeting"]), Severity.Success);
                    await RefreshEvents();
                }
                catch (Exception ex)
                {
                    Snackbar.Add(string.Format(Loc["ErrorUpdating"], ex.Message), Severity.Error);
                }
            }
        }
        else
        {
            // Dialog was cancelled - refresh to revert any UI changes
            await RefreshEvents();
        }
    }

    [JSInvokable]
    public async Task OnEventDrop(int id, string startStr, string endStr)
    {
        try
        {
            var meeting = await MeetingService.GetByIdAsync(id);
            if (meeting == null) return;

            var newStart = DateTime.Parse(startStr, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind);
            var newEnd = DateTime.Parse(endStr, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind);

            meeting.From = newStart.ToLocalTime();
            meeting.To = newEnd.ToLocalTime();

            await MeetingService.UpdateAsync(meeting, _userName);
            Snackbar.Add(Loc["MeetingMoved"], Severity.Success);
            await RefreshEvents();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["ErrorUpdating"], ex.Message), Severity.Error);
            await RefreshEvents();
        }
    }

    [JSInvokable]
    public async Task OnEventResize(int id, string startStr, string endStr)
    {
        try
        {
            var meeting = await MeetingService.GetByIdAsync(id);
            if (meeting == null) return;

            var newStart = DateTime.Parse(startStr, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind);
            var newEnd = DateTime.Parse(endStr, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind);

            meeting.From = newStart.ToLocalTime();
            meeting.To = newEnd.ToLocalTime();

            await MeetingService.UpdateAsync(meeting, _userName);
            Snackbar.Add(Loc["MeetingMoved"], Severity.Success);
            await RefreshEvents();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["ErrorUpdating"], ex.Message), Severity.Error);
            await RefreshEvents();
        }
    }

    private async Task RefreshEvents()
    {
        var selectedWorkerIds = _workerFilters
            .Where(w => w.Selected && w.WorkerId.HasValue)
            .Select(w => w.WorkerId!.Value)
            .ToArray();

        if (selectedWorkerIds.Length == 0)
        {
            // Show no events when no workers selected
            if (_calendarInitialized)
                await JS.InvokeVoidAsync("schedulerInterop.setEvents", Array.Empty<object>());
            return;
        }

        _meetings = await MeetingService.GetByDateRangeAsync(_viewStart, _viewEnd, selectedWorkerIds);

        var events = _meetings.Select(m => MapToFullCalendarEvent(m)).ToArray();

        if (_calendarInitialized)
            await JS.InvokeVoidAsync("schedulerInterop.setEvents", (object)events);
    }

    private object MapToFullCalendarEvent(Meeting m)
    {
        var bgColor = GetMeetingTypeColor(m.MeetingType?.Color);
        var borderColor = GetWorkerColor(m.ConsultantId);

        var title = "";
        if (m.Consultant != null)
            title += m.Consultant.SurName;
        if (m.MeetingType != null)
            title += (title.Length > 0 ? " " : "") + m.MeetingType.Abbreviation;

        var tooltipHtml = BuildTooltipHtml(m);

        return new
        {
            id = m.Id.ToString(),
            title = title,
            start = m.From.ToString("yyyy-MM-ddTHH:mm:ss"),
            end = m.To.ToString("yyyy-MM-ddTHH:mm:ss"),
            backgroundColor = bgColor,
            borderColor = borderColor,
            textColor = bgColor == "#d1d3d3" ? "#333" : "#fff",
            extendedProps = new { tooltipHtml = tooltipHtml }
        };
    }

    private string GetMeetingTypeColor(string? colorName)
    {
        return colorName switch
        {
            "green" => "#7df921",
            "orange" => "#f97921",
            "blue" => "#2187f9",
            "red" => "#f92142",
            "white" => "#d1d3d3",
            _ => "#d1d3d3"
        };
    }

    private string GetWorkerColor(int? consultantId)
    {
        if (!consultantId.HasValue) return "#999";
        var index = _workers.FindIndex(w => w.Id == consultantId.Value);
        if (index < 0) return "#999";
        return WorkerColors[index % WorkerColors.Length];
    }

    private string BuildTooltipHtml(Meeting m)
    {
        var lines = new System.Text.StringBuilder();
        lines.Append($"<div><b>{m.From:HH:mm}</b> - <b>{m.To:HH:mm}</b></div>");
        if (m.Client != null)
            lines.Append($"<div><b>{Loc["Client"]}:</b> {System.Net.WebUtility.HtmlEncode(m.ClientFullName)}</div>");
        if (m.Consultant != null)
            lines.Append($"<div><b>{Loc["Consultant"]}:</b> {System.Net.WebUtility.HtmlEncode(m.ConsultantFullName)}</div>");
        if (m.MeetingType != null)
            lines.Append($"<div><b>{Loc["MeetingType"]}:</b> {System.Net.WebUtility.HtmlEncode(m.MeetingType.Name)}</div>");
        if (m.MeetingState != null)
            lines.Append($"<div><b>{Loc["MeetingState"]}:</b> {System.Net.WebUtility.HtmlEncode(m.MeetingState.Name)}</div>");
        if (!string.IsNullOrEmpty(m.Title))
            lines.Append($"<div><b>{Loc["Name"]}:</b> {System.Net.WebUtility.HtmlEncode(m.Title)}</div>");
        if (!string.IsNullOrEmpty(m.Description))
            lines.Append($"<div><b>{Loc["Description"]}:</b> {System.Net.WebUtility.HtmlEncode(m.Description)}</div>");
        return lines.ToString();
    }

    private async Task ChangeView(string viewName)
    {
        _currentView = viewName;
        if (_calendarInitialized)
            await JS.InvokeVoidAsync("schedulerInterop.changeView", viewName);
    }

    private async Task Prev()
    {
        if (_calendarInitialized)
            await JS.InvokeVoidAsync("schedulerInterop.prev");
    }

    private async Task Next()
    {
        if (_calendarInitialized)
            await JS.InvokeVoidAsync("schedulerInterop.next");
    }

    private async Task GoToToday()
    {
        _selectedDate = DateTime.Today;
        if (_calendarInitialized)
            await JS.InvokeVoidAsync("schedulerInterop.today");
    }

    private async Task OnDatePickerChanged(DateTime? date)
    {
        if (_suppressDatePickerCallback) return;
        if (date.HasValue && _calendarInitialized)
        {
            _selectedDate = date;
            await JS.InvokeVoidAsync("schedulerInterop.gotoDate", date.Value.ToString("yyyy-MM-dd"));
        }
    }

    private async Task OnWorkerFilterChanged(WorkerSchedulerFilter worker, bool selected)
    {
        worker.Selected = selected;
        await RefreshEvents();
    }

    public void Dispose()
    {
        if (_calendarInitialized)
        {
            _ = JS.InvokeVoidAsync("schedulerInterop.destroy");
        }
        _dotNetRef?.Dispose();
    }
}
