@inject IStringLocalizer<SharedResource> Loc

<MudSelect T="string" @bind-Value="_selectedValue" Label="@Loc["Graph_SelectValue"]" Class="mb-4">
    <MudSelectItem Value="@("GlycatedHemoglobin")">@Loc["GlycatedHemoglobin"]</MudSelectItem>
    <MudSelectItem Value="@("Homocysteine")">@Loc["Homocysteine"]</MudSelectItem>
    <MudSelectItem Value="@("Creatinine")">@Loc["Creatinine"]</MudSelectItem>
    <MudSelectItem Value="@("UricAcid")">@Loc["UricAcid"]</MudSelectItem>
    <MudSelectItem Value="@("Urea")">@Loc["Urea"]</MudSelectItem>
    <MudSelectItem Value="@("CRP")">CRP</MudSelectItem>
    <MudSelectItem Value="@("TSH")">TSH</MudSelectItem>
</MudSelect>

@if (_hasData)
{
    <ApexChart TItem="ChartDataPoint" Options="_options" Height="400">
        <ApexPointSeries TItem="ChartDataPoint"
                         Items="_data"
                         Name="@_seriesName"
                         SeriesType="SeriesType.Line"
                         XValue="@(e => e.Date.ToString("dd.MM.yyyy"))"
                         YValue="@(e => (decimal)e.Value)" />
    </ApexChart>
}
else if (!string.IsNullOrEmpty(_selectedValue))
{
    <MudAlert Severity="Severity.Info">@Loc["Graph_NoData"]</MudAlert>
}

@code {
    [Parameter] public Client? Client { get; set; }

    private string _selectedValue = "GlycatedHemoglobin";
    private string _seriesName = "";
    private List<ChartDataPoint> _data = new();
    private bool _hasData;
    private ApexChartOptions<ChartDataPoint> _options = new();

    protected override void OnParametersSet()
    {
        LoadData();
    }

    private void LoadData()
    {
        _data.Clear();

        if (Client?.Biochemistry == null || string.IsNullOrEmpty(_selectedValue))
        {
            _hasData = false;
            return;
        }

        _seriesName = _selectedValue switch
        {
            "GlycatedHemoglobin" => Loc["GlycatedHemoglobin"],
            "Homocysteine" => Loc["Homocysteine"],
            "Creatinine" => Loc["Creatinine"],
            "UricAcid" => Loc["UricAcid"],
            "Urea" => Loc["Urea"],
            "CRP" => "CRP",
            "TSH" => "TSH",
            _ => _selectedValue
        };

        Func<ClientBiochemistry, decimal> valueSelector = _selectedValue switch
        {
            "GlycatedHemoglobin" => b => b.GlycatedHemoglobin,
            "Homocysteine" => b => b.Homocysteine,
            "Creatinine" => b => b.Creatinine,
            "UricAcid" => b => b.UricAcid,
            "Urea" => b => b.Urea,
            "CRP" => b => b.CRP,
            "TSH" => b => b.TSH,
            _ => b => 0
        };

        var records = Client.Biochemistry
            .Where(b => valueSelector(b) > 0)
            .OrderBy(b => b.Date)
            .ToList();

        foreach (var b in records)
        {
            _data.Add(new ChartDataPoint(b.Date, valueSelector(b)));
        }

        _data = ChartDataPoint.DeduplicateByDate(_data);

        _hasData = _data.Count > 0;

        _options = new ApexChartOptions<ChartDataPoint>
        {
            Chart = new Chart { Type = ApexCharts.ChartType.Line },
            Xaxis = new XAxis { Type = XAxisType.Category },
            Stroke = new Stroke { Curve = Curve.Smooth }
        };
    }
}
