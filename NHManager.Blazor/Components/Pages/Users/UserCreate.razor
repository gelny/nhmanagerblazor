@page "/users/create"
@attribute [Authorize(Roles = Roles.AdminAndSuper)]
@using Microsoft.Extensions.Localization
@using NHManager.Blazor.Resources
@inject IAuthService AuthService
@inject IWorkerService WorkerService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@using NHManager.Blazor.Models
@using NHManager.Blazor.Auth
@using NHManager.Blazor.Constants
@using NHManager.Blazor.Services
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["NewUser"] - NHManager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@Loc["NewUser"]</MudText>

<MudPaper Class="pa-6">
    <EditForm Model="_registerModel" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_registerModel.Username" Label="@Loc["Username"]" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_registerModel.Email" Label="@Loc["Email"]" InputType="InputType.Email" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_registerModel.Password" Label="@Loc["Password"]" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_registerModel.ConfirmPassword" Label="@Loc["ConfirmPassword"]" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_registerModel.Role" Label="@Loc["Role"]" Required="true" Variant="Variant.Outlined">
                    <MudSelectItem Value="@Roles.Admin">@Loc["Admin"]</MudSelectItem>
                    <MudSelectItem Value="@Roles.SuperEmployee">@Loc["SuperEmployee"]</MudSelectItem>
                    <MudSelectItem Value="@Roles.Employee">@Loc["Employee"]</MudSelectItem>
                    <MudSelectItem Value="@Roles.Customer">@Loc["Customer"]</MudSelectItem>
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_registerModel.WorkerId" Label="@Loc["LinkToWorker"]" Variant="Variant.Outlined" T="int?">
                    <MudSelectItem Value="@((int?)null)">@Loc["NoneSelected"]</MudSelectItem>
                    @foreach (var worker in _workers)
                    {
                        <MudSelectItem Value="@((int?)worker.Id)">@worker.FullName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
        
        <MudDivider Class="my-6" />
        
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="/users">@Loc["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="_saving">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @Loc["Create"]
            </MudButton>
        </MudStack>
    </EditForm>
</MudPaper>

@code {
    private RegisterModel _registerModel = new();
    private List<Worker> _workers = new();
    private bool _saving = false;

    protected override async Task OnInitializedAsync()
    {
        _workers = await WorkerService.GetActiveAsync();
    }

    private async Task HandleSubmit()
    {
        _saving = true;
        try
        {
            var result = await AuthService.RegisterAsync(_registerModel);
            if (result.Success)
            {
                Snackbar.Add(string.Format(Loc["CreatedSuccess"].Value, Loc["User"].Value), Severity.Success);
                Navigation.NavigateTo("/users");
            }
            else
            {
                 Snackbar.Add(result.Message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
             Snackbar.Add(string.Format(Loc["ErrorCreating"].Value, ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
