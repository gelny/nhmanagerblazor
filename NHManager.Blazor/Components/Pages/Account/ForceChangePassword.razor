@page "/force-change-password"
@attribute [Authorize]
@layout EmptyLayout
@using Microsoft.Extensions.Localization
@using NHManager.Blazor.Resources
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject CustomAuthStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>Změna hesla - NHManager</PageTitle>

<div class="login-wrapper">
    <div class="login-bg"></div>
    <MudPaper Class="login-card pa-8 pa-md-10" Elevation="4">
        <div class="d-flex flex-column align-center mb-6">
            <MudAvatar Size="Size.Large" Style="background: linear-gradient(135deg, #264653, #2E7D6F); width: 64px; height: 64px;" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Rounded.Lock" Size="Size.Large" Style="color: white;" />
            </MudAvatar>
            <MudText Typo="Typo.h5" Style="font-weight: 700;">Změna hesla</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Je nutné změnit výchozí heslo</MudText>
        </div>

        <MudTextField @bind-Value="_newPassword"
                      Label="Nové heslo"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Class="mb-4" />

        <MudTextField @bind-Value="_confirmPassword"
                      Label="Potvrzení hesla"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Class="mb-4" />

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">
            Min. 8 znaků, velké a malé písmeno, číslice
        </MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled" Dense="true">@_errorMessage</MudAlert>
        }

        <MudButton OnClick="HandleChangePassword"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   Disabled="_saving"
                   Class="login-btn">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Color="Color.Surface" />
            }
            Změnit heslo
        </MudButton>
    </MudPaper>
</div>

<style>
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }
    .login-bg {
        position: fixed;
        inset: 0;
        background: linear-gradient(135deg, #264653 0%, #2E7D6F 40%, #4CA695 70%, #F4A261 100%);
        z-index: 0;
    }
    .login-card {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 420px;
        border-radius: 16px !important;
    }
    .login-btn {
        text-transform: none !important;
        font-weight: 600 !important;
        font-size: 0.95rem !important;
        padding: 12px !important;
    }
</style>

@code {
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string _errorMessage = "";
    private bool _saving = false;
    private int _userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst("UserId");
        if (userIdClaim == null || !int.TryParse(userIdClaim.Value, out _userId))
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    private async Task HandleChangePassword()
    {
        if (string.IsNullOrWhiteSpace(_newPassword) || string.IsNullOrWhiteSpace(_confirmPassword))
        {
            _errorMessage = "Vyplňte obě pole";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "Hesla se neshodují";
            return;
        }

        _saving = true;
        _errorMessage = "";
        StateHasChanged();

        try
        {
            var result = await AuthService.ForceChangePasswordAsync(_userId, _newPassword);
            if (result.Success)
            {
                Snackbar.Add("Heslo bylo úspěšně změněno", Severity.Success);
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                _errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Chyba: {ex.Message}";
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }
}
