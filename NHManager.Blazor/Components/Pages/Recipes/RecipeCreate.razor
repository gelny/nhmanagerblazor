@page "/recipes/create"
@attribute [Authorize(Roles = Roles.AllEmployees)]
@using Microsoft.Extensions.Localization
@using NHManager.Blazor.Resources
@inject IRecipeService RecipeService
@inject IFoodService FoodService
@inject IWorkerService WorkerService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@using NHManager.Blazor.Models
@using NHManager.Blazor.Services
@using NHManager.Blazor.Constants
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["NewRecipe"] - NHManager</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@Loc["NewRecipe"]</MudText>

<MudPaper Class="pa-6">
    <EditForm Model="_recipe" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        
        <MudGrid>
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="_recipe.Name" Label="@Loc["Name"]" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            
            <MudItem xs="12" sm="4">
                <MudSelect @bind-Value="_recipe.ConsultantId" Label="@Loc["Consultant"]" Variant="Variant.Outlined" T="int?">
                    <MudSelectItem Value="@((int?)null)">@Loc["NotSelected"]</MudSelectItem>
                    @foreach (var worker in _workers)
                    {
                        <MudSelectItem Value="@((int?)worker.Id)">@worker.FullName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_recipe.Description" Label="@Loc["Description"]" Variant="Variant.Outlined" Lines="3" />
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1">@Loc["SuitableForMeals"]:</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap">
                    <MudCheckBox @bind-Value="_recipe.Breakfast" Label="@Loc["Breakfast"]" Color="Color.Primary" Dense="true" />
                    <MudCheckBox @bind-Value="_recipe.MorningSnack" Label="@Loc["MorningSnack"]" Color="Color.Primary" Dense="true" />
                    <MudCheckBox @bind-Value="_recipe.Lunch" Label="@Loc["Lunch"]" Color="Color.Primary" Dense="true" />
                    <MudCheckBox @bind-Value="_recipe.AfternoonSnack" Label="@Loc["AfternoonSnack"]" Color="Color.Primary" Dense="true" />
                    <MudCheckBox @bind-Value="_recipe.Dinner1" Label="@Loc["Dinner1"]" Color="Color.Primary" Dense="true" />
                    <MudCheckBox @bind-Value="_recipe.Dinner2" Label="@Loc["Dinner2"]" Color="Color.Primary" Dense="true" />
                </MudStack>
            </MudItem>
        </MudGrid>
        
        <MudDivider Class="my-6" />
        
        <MudText Typo="Typo.h6" Class="mb-2">@Loc["Ingredients"]</MudText>
        
        <MudTable Items="_recipe.RecipeItems" Hover="true" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>@Loc["Ingredient"]</MudTh>
                <MudTh>@Loc["Amount"]</MudTh>
                <MudTh>@Loc["Unit"]</MudTh>
                <MudTh>@string.Format("{0} ({1})", Loc["Energy"].Value, Loc["Kcal"].Value)</MudTh>
                <MudTh>@Loc["Protein"]</MudTh>
                <MudTh>@Loc["Carbohydrate"]</MudTh>
                <MudTh>@Loc["Fat"]</MudTh>
                <MudTh>@Loc["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate Context="recipeItem">
                <MudTd>
                    @if (recipeItem.Food != null)
                    {
                        @recipeItem.Food.Name_CZ
                    }
                    else
                    {
                         <MudAutocomplete T="Food" Label="@Loc["SelectIngredient"]" Value="recipeItem.Food" ValueChanged="@((Food f) => OnFoodSelected(recipeItem, f))" SearchFunc="@SearchFoods"
                                         ToStringFunc="@(f => f == null ? null : $"{f.Name_CZ} ({f.EnergyKcal} kcal/100g)")"
                                         Variant="Variant.Text" />
                    }
                </MudTd>
                <MudTd>
                    <MudNumericField Value="recipeItem.Count" ValueChanged="@((int c) => OnCountChanged(recipeItem, c))" Min="0" Variant="Variant.Text" Margin="Margin.Dense" Immediate="true" />
                </MudTd>
                <MudTd>
                     <MudSelect @bind-Value="recipeItem.Unit" Variant="Variant.Text" Margin="Margin.Dense" T="int">
                        <MudSelectItem Value="1">g</MudSelectItem>
                        <MudSelectItem Value="2">ml</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd>@recipeItem.EnergyKcal</MudTd>
                <MudTd>@recipeItem.Protein.ToString("F1")</MudTd>
                <MudTd>@recipeItem.Carbohydrate.ToString("F1")</MudTd>
                <MudTd>@recipeItem.Fat.ToString("F1")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveItem(recipeItem))" />
                </MudTd>
            </RowTemplate>
             <FooterContent>
                <MudTd colspan="8">
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text" Color="Color.Primary" OnClick="AddItem">@Loc["AddIngredient"]</MudButton>
                </MudTd>
            </FooterContent>
        </MudTable>

        <MudDivider Class="my-4" />
        
        <MudGrid>
             <MudItem xs="12" sm="3">
                <MudField Label="@Loc["TotalEnergyKcal"]" Variant="Variant.Outlined">@_recipe.EnergyKcal</MudField>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudField Label="@Loc["TotalProtein"]" Variant="Variant.Outlined">@_recipe.Protein.ToString("F1")</MudField>
            </MudItem>
            <MudItem xs="12" sm="3">
                 <MudField Label="@Loc["TotalCarbohydrates"]" Variant="Variant.Outlined">@_recipe.Carbohydrate.ToString("F1")</MudField>
            </MudItem>
            <MudItem xs="12" sm="3">
                 <MudField Label="@Loc["TotalFat"]" Variant="Variant.Outlined">@_recipe.Fat.ToString("F1")</MudField>
            </MudItem>
        </MudGrid>
        
        <MudDivider Class="my-6" />
        
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="/recipes">@Loc["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Disabled="_saving">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @Loc["Save"]
            </MudButton>
        </MudStack>
    </EditForm>
</MudPaper>

@code {
    private Recipe _recipe = new() { RecipeItems = new List<RecipeItem>(), CreateDate = DateTime.Now };
    private List<Worker> _workers = new();
    
    private List<Food> _allFoodsCache = new();

    private bool _saving = false;

    protected override async Task OnInitializedAsync()
    {
        _workers = await WorkerService.GetActiveAsync();
        _allFoodsCache = await FoodService.GetAllAsync(); // Cache all foods for search
        
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var workerId = await ((CustomAuthStateProvider)AuthStateProvider).GetCurrentWorkerId();
        if (workerId.HasValue)
        {
            _recipe.ConsultantId = workerId.Value;
        }
    }

    private async Task<IEnumerable<Food>> SearchFoods(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return _allFoodsCache;
            
        return _allFoodsCache.Where(x => x.Name_CZ.Contains(value, StringComparison.OrdinalIgnoreCase) || x.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private void AddItem()
    {
        _recipe.RecipeItems.Add(new RecipeItem { Count = 100, Unit = 1 }); // Default 100g
        RecalculateRecipeTotals();
    }

    private void RemoveItem(RecipeItem item)
    {
        _recipe.RecipeItems.Remove(item);
        RecalculateRecipeTotals();
    }

    private void OnFoodSelected(RecipeItem item, Food food)
    {
        if (food != null)
        {
            item.Food = food;
            item.FoodId = food.Id;
            RecalculateItem(item);
        }
    }
    
    private void OnCountChanged(RecipeItem item, int count)
    {
        item.Count = count;
        RecalculateItem(item);
    }
    
    private void RecalculateItem(RecipeItem item)
    {
        if (item.Food == null) return;
        
        // Values are per 100g/ml
        decimal factor = item.Count / 100m;
        
        item.Protein = item.Food.Protein * factor;
        item.Carbohydrate = item.Food.Carbohydrate * factor;
        item.Fat = item.Food.Fat * factor;
        
        item.EnergyKcal = (int)Math.Round(item.Food.EnergyKcal * factor);
        item.EnergyKJ = (int)Math.Round(item.Food.EnergyKJ * factor);
        
        // Also update FromFood properties if they are redundant or specific
        item.ProteinFromFood = item.Protein;
        item.CarbohydrateFromFood = item.Carbohydrate;
        item.FatFromFood = item.Fat;
        item.EnergyKcalFromFood = item.EnergyKcal;
        item.EnergyKJFromFood = item.EnergyKJ;
        
        RecalculateRecipeTotals();
    }

    private void RecalculateRecipeTotals()
    {
        _recipe.Protein = _recipe.RecipeItems.Sum(x => x.Protein);
        _recipe.Carbohydrate = _recipe.RecipeItems.Sum(x => x.Carbohydrate);
        _recipe.Fat = _recipe.RecipeItems.Sum(x => x.Fat);
        _recipe.EnergyKcal = _recipe.RecipeItems.Sum(x => x.EnergyKcal);
        _recipe.EnergyKJ = _recipe.RecipeItems.Sum(x => x.EnergyKJ);
    }

    private async Task HandleSubmit()
    {
        _saving = true;
        try
        {
            // Update string properties
            _recipe.Protein_string = _recipe.Protein.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _recipe.Carbohydrate_string = _recipe.Carbohydrate.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _recipe.Fat_string = _recipe.Fat.ToString(System.Globalization.CultureInfo.InvariantCulture);
            
            foreach(var item in _recipe.RecipeItems)
            {
                 // Clear tracking
                 item.Food = null;
                 
                 item.Protein_string = item.Protein.ToString(System.Globalization.CultureInfo.InvariantCulture);
                 item.Carbohydrate_string = item.Carbohydrate.ToString(System.Globalization.CultureInfo.InvariantCulture);
                 item.Fat_string = item.Fat.ToString(System.Globalization.CultureInfo.InvariantCulture);
                 
                 // FromFood strings
                 item.ProteinFromFood_string = item.ProteinFromFood.ToString(System.Globalization.CultureInfo.InvariantCulture);
                 item.CarbohydrateFromFood_string = item.CarbohydrateFromFood.ToString(System.Globalization.CultureInfo.InvariantCulture);
                 item.FatFromFood_string = item.FatFromFood.ToString(System.Globalization.CultureInfo.InvariantCulture);
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name ?? "System";

            await RecipeService.CreateAsync(_recipe, userName);
             Snackbar.Add(string.Format(Loc["CreatedSuccess"].Value, Loc["Recipe"].Value), Severity.Success);
            Navigation.NavigateTo("/recipes");
        }
        catch (Exception ex)
        {
             Snackbar.Add(string.Format(Loc["ErrorCreating"].Value, ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
